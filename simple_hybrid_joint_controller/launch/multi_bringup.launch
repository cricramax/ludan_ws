<launch>
  <!-- 右臂 MCU -->
  <group ns="mcu_rightarm">
    <arg name="port" default="/dev/mcu_rightarm"/>
    <arg name="baud" default="921600"/>
    <include file="$(find simple_hybrid_joint_controller)/launch/bringup_real.launch">
      <arg name="port" value="$(arg port)"/>
      <arg name="baud" value="$(arg baud)"/>
      <arg name="ns" value="/mcu_rightarm"/>
      <arg name="movej_joint_names" value="['leg_r1_joint','leg_r2_joint','leg_r3_joint','leg_r4_joint','leg_r5_joint','leg_r6_joint','leg_r7_joint']"/>
      <arg name="default_kp" value="30.0"/>
    </include>
  </group>
  <!-- left arm MCU -->
    <group ns="mcu_leftarm">
      <arg name="port" default="/dev/mcu_leftarm"/>
      <arg name="baud" default="921600"/>
      <include file="$(find simple_hybrid_joint_controller)/launch/bringup_real.launch">
        <arg name="port" value="$(arg port)"/>
        <arg name="baud" value="$(arg baud)"/>
        <arg name="ns" value="/mcu_leftarm"/>
        <arg name="movej_joint_names" value="['leg_l1_joint','leg_l2_joint','leg_l3_joint','leg_l4_joint','leg_l5_joint','leg_l6_joint','leg_l7_joint']"/>
        <arg name="default_kp" value="30.0"/>
      </include>
    </group>
  <!-- neck MCU -->
  <group ns="mcu_neck">
    <arg name="port" default="/dev/mcu_neck"/>
    <arg name="baud" default="921600"/>
    <include file="$(find simple_hybrid_joint_controller)/launch/bringup_real.launch">
      <arg name="port" value="$(arg port)"/>
      <arg name="baud" value="$(arg baud)"/>
      <arg name="ns" value="/mcu_neck"/>
    </include>
  </group>
  <!-- left leg MCU -->
    <!-- <group ns="mcu_leftleg">
      <arg name="port" default="/dev/mcu_leftleg"/>
      <arg name="baud" default="921600"/>
      <include file="$(find simple_hybrid_joint_controller)/launch/bringup_real.launch">
        <arg name="port" value="$(arg port)"/>
        <arg name="baud" value="$(arg baud)"/>
        <arg name="ns" value="/mcu_leftleg"/>
        <arg name="movej_joint_names" value="['leg_l1_joint','leg_l2_joint','leg_l3_joint','leg_l4_joint','leg_l5_joint','leg_l6_joint']"/>
      </include>
      <rosparam param="all_joints_hjc/moveJ_joint_names">
        ['leg_l1_joint','leg_l2_joint','leg_l3_joint','leg_l4_joint','leg_l5_joint','leg_l6_joint']
      </rosparam>
    </group> -->
      <!-- left arm MCU -->
    <group ns="mcu_leftleg">
      <arg name="port" default="/dev/mcu_leftleg"/>
      <arg name="baud" default="921600"/>
      <include file="$(find simple_hybrid_joint_controller)/launch/bringup_real.launch">
        <arg name="port" value="$(arg port)"/>
        <arg name="baud" value="$(arg baud)"/>
        <arg name="ns" value="/mcu_leftleg"/>
        <arg name="movej_joint_names" value="['leg_l1_joint','leg_l2_joint','leg_l3_joint','leg_l4_joint','leg_l5_joint','leg_l6_joint','leg_l7_joint']"/>
        <arg name="default_kp" value="30.0"/>
      </include>
    </group>


    <!-- right leg MCU -->
    <group ns="mcu_rightleg">
      <arg name="port" default="/dev/mcu_rightleg"/>
      <arg name="baud" default="921600"/>
      <include file="$(find simple_hybrid_joint_controller)/launch/bringup_real.launch">
        <arg name="port" value="$(arg port)"/>
        <arg name="baud" value="$(arg baud)"/>
        <arg name="ns" value="/mcu_rightleg"/>
        <arg name="movej_joint_names" value="['leg_r1_joint','leg_r2_joint','leg_r3_joint','leg_r4_joint','leg_r5_joint','leg_r6_joint']"/>
      </include>
      <rosparam param="all_joints_hjc/moveJ_joint_names">
        ['leg_r1_joint','leg_r2_joint','leg_r3_joint','leg_r4_joint','leg_r5_joint','leg_r6_joint']
      </rosparam>
    </group>

</launch>
